# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

GET     /                           controllers.HomeController.index()

# von /public to assets
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

GET     /menu                       controllers.HomeController.index()

GET     /ingame                     controllers.HomeController.ingame()
POST    /ingame                     controllers.HomeController.ingame()

GET     /demo_input/:input          controllers.HomeController.demoOffer(input: String)

GET     /theme/toggle               controllers.ThemeController.toggleTheme(returnTo: String ?= "/home")

GET     /home                       controllers.HomeController.home()

GET     /rules                      controllers.HomeController.index()

GET     /createPlayers/:names       controllers.HomeController.createPlayers(names: String)

POST    /bid                        controllers.HomeController.bid()

GET     /javascriptRoutes           controllers.javascriptControllerRoutes.javaScriptRoutes()

# Json POST
POST    /api/demoOffer              controllers.HomeController.demoOfferJson()
POST    /api/players                controllers.HomeController.createPlayersJson()
POST    /api/playCard               controllers.HomeController.playCardJson()
POST    /api/bid                    controllers.HomeController.bidJson()

# Json GET
GET     /api/gameState              controllers.HomeController.gameState()
GET     /api/starSettings           controllers.HomeController.starSettings()

GET     /api/playerPresets/:id      controllers.HomeController.playerPreset(id: Long)

POST    /api/players/save           controllers.HomeController.savePlayersJson()

GET     /jsroutes                   controllers.HomeController.jsRoutes()

# Silhouette
GET     /api/auth/user              controllers.SilhouetteAuthController.user
POST    /api/auth/login             controllers.SilhouetteAuthController.login
POST    /api/auth/signup            controllers.SilhouetteAuthController.signUp
POST    /api/auth/signout           controllers.SilhouetteAuthController.signOut

# Web Socket
GET     /game/socket                wizard.controller.GameSocketController.socket

GET     /play/:name                 controllers.HomeController.playFor(name: String)

GET     /pwa/api/gameState          controllers.HomeController.gameState()
GET     /pwa/api/starSettings       controllers.HomeController.starSettings()
GET     /pwa/api/playerPresets/:id  controllers.HomeController.playerPreset(id: Long)
POST    /pwa/api/players            controllers.HomeController.createPlayersJson()
POST    /pwa/api/playCard           controllers.HomeController.playCardJson()
POST    /pwa/api/bid                controllers.HomeController.bidJson()
POST    /pwa/api/players/save       controllers.HomeController.savePlayersJson()
GET     /pwa/jsroutes               controllers.HomeController.jsRoutes()
